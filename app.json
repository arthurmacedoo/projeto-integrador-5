{
  "expo": {
    "name": "TchôEduca",
    "slug": "tchoeduca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tchoeduca",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tchoeduca.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.tchoeduca.app",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "shortName": "TchoEduca",
      "lang": "pt-BR",
      "description": "Educação financeira gamificada contra golpes de Pix e WhatsApp.",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
